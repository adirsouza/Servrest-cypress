{
  "name": "serverest-cypress-e2e",
  "version": "1.0.0",
  "description": "Testes automatizados E2E (Frontend) e de API para a aplicação ServeRest, utilizando Cypress + JavaScript.",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:frontend": "cypress run --spec \"cypress/e2e/frontend/**/*.cy.js\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "test:all": "cypress run"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "@faker-js/faker": "^8.4.1"
  },
  "author": "Adir Leite de Souza",
  "license": "MIT"
}
